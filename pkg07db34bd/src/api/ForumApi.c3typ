/**
 * BoilerConnect forum API (owned by Lane A). The ONLY data surface the UI uses for members, posts, and replies
 * (there are no likes): every method takes the persona switcher's `actorId` and returns view types with identity stripped from
 * anonymous items. Entity types are never fetched directly from the UI.
 */
type ForumApi {

  /** All members, for the persona switcher (includes badges). */
  listMembers: function(): [MemberView] js-server

  /** One member's public profile. */
  getMember: function(id: !string): MemberView js-server

  /**
   * Ranked feed. Three spaces that all work the same: `students` | `experts` (aliases `faculty`, `professors`) |
   * `alumni` — each
   * shows every PUBLIC question that {@link AiPipeline#analyzePost} routed there. `foryou` shows every PUBLIC
   * question across spaces. `dept` (optional) filters any tab. Anyone can
   * read and reply in any space; EXPERTS_ONLY posts never appear in feeds. Sorted by
   * `hot = (replies + 2·expertReplies + 1) / (hoursSincePost + 2)^1.5`.
   */
  feed: function(actorId: !string, tab: string, dept: string): [PostView] js-server

  /**
   * "Questions for you": Experts- and Alumni-space questions the actor was tagged on (includes EXPERTS_ONLY).
   * Always empty for students.
   */
  inbox: function(actorId: !string): [PostView] js-server

  /**
   * A post and its replies. Replies are grouped: EXPERTS (faculty) answers first, then ALUMNI, then STUDENT (oldest first in
   * each group; see {@link ReplyView#authorGroup}). Throws if EXPERTS_ONLY and the actor is neither the author nor
   * a matched expert.
   */
  getPost: function(actorId: !string, postId: !string): PostDetailView js-server

  /**
   * Creates a post: builds the expert directory, calls {@link AiPipeline#analyzePost}, blocks unsafe posts
   * (nothing saved), then saves the question and — only when it is routed to the Experts or Alumni space — its
   * {@link ExpertMatch} rows (Student-space questions tag no one and are always PUBLIC). Only STUDENT and ALUMNI can post
   * (experts/faculty answer, they never ask); there are no articles. The returned PostView carries only the
   * expert count — never the tagged experts' identities.
   */
  createPost: function(actorId: !string, input: !NewPostInput): CreatePostResult js-server

  /** Adds a reply. Anyone can answer any post they can see; students are always anonymous. +1 reputation. */
  reply: function(actorId: !string, postId: !string, body: !string, isAnonymous: boolean): ReplyView js-server

}
