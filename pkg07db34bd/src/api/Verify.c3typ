/**
 * Purdue email verification rules (owned by Lane A).
 */
type Verify {

  /**
   * Signup gate. `@purdue.edu` + STUDENT/FACULTY → admitted; `@alumni.purdue.edu` → ALUMNI, admitted; anything
   * else → not admitted. Everyone on the platform passed this check, so the UI never labels anyone "verified".
   */
  check: function(email: !string, role: string): VerifyResult js-server
}
