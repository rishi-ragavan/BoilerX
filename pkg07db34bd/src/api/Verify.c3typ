/**
 * Purdue email verification rules (owned by Lane A).
 */
type Verify {

  /**
   * `@purdue.edu` + STUDENT/FACULTY → verified; `@alumni.purdue.edu` → ALUMNI, verified; any other email as
   * ALUMNI → unverified ("Unverified alum"); anything else → not verified.
   */
  check: function(email: !string, role: string): VerifyResult js-server
}
