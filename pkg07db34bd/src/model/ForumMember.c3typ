/**
 * A BoilerConnect member: a Purdue student, professor, or alum. Named `ForumMember` because the platform already
 * ships a (deprecated) `Member` entity type. The inherited `name` field holds the real name, which is used on the
 * backend only (identity checks) and never for anonymous items.
 *
 * Members are categorized ONLY as professor (role FACULTY, shown with the "Expert" tag), alum ("Alumni" tag), or
 * student (no tag). There are no levels, badges, or reputation. Never returned to the UI directly; {@link ForumApi}
 * serializes it into {@link MemberView} / {@link AuthorView}.
 */
@db(index=['email'])
entity type ForumMember {

  /** Purdue email (`@purdue.edu`, or `@alumni.purdue.edu` for alumni). */
  email: !string

  /** Category: STUDENT, FACULTY (professor, labeled "Expert"), or ALUMNI (see {@link ForumMember.Role}). */
  role: !ForumMember.Role

  /**
   * Set when {@link Verify#check} accepted the email at signup. Only verified Purdue members are on the platform, so
   * this is an internal gate (re-checked on post/reply) and is never shown in the UI.
   */
  verified: boolean = false

  /** Department. Part of a professor's flair (e.g. `Finance`). */
  department: string

  /** Current employer (alumni). Shown in an alum's flair only when they post under their name. */
  employer: string

  /** Short bio. The first 120 characters feed the AI expert directory. */
  bio: string

  /**
   * Flair tags. Professors: research interests (e.g. `asset pricing`). Alumni: a broad career role (e.g. `SWE`,
   * `Product Manager`). Students: always empty (students have no listed expertise).
   */
  tags: [string]

  /** Professor / alumni default for the per-post anonymity toggle. Students are always anonymous. */
  anonByDefault: boolean = false
}
