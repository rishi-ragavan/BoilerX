/**
 * The space a {@link Post} is routed to by {@link AiPipeline#analyzePost}. All three spaces work identically.
 */
enum type Post.Space {
  /**
   * Student space: peer and campus-life questions.
   */
  STUDENT,
  /**
   * Experts space (formerly "Faculty"): academic, research, or deep subject questions.
   */
  EXPERTS,
  /**
   * Alumni space: career, industry, or job questions.
   */
  ALUMNI
}
