/**
 * The role of a {@link ForumMember}.
 */
enum type ForumMember.Role {
  /**
   * Current Purdue student. Always anonymous; can never start a DM.
   */
  STUDENT,
  /**
   * Purdue faculty, labeled "Expert" in the UI (e.g. "Expert · Finance"). The only role allowed to start a DM
   * (DM_INITIATOR_ROLES). The role value stays FACULTY; only the label changed.
   */
  FACULTY,
  /**
   * Purdue alum (must sign up with an `@alumni.purdue.edu` email).
   */
  ALUMNI
}
