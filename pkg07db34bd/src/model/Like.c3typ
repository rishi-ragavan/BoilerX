/**
 * A like by a {@link ForumMember} on either a {@link Post} or a {@link Reply} (exactly one of the two is set).
 */
@db(index=['member', 'post', 'reply'])
entity type Like {

  /** The member who liked. */
  member: !ForumMember

  /** The liked post, when liking a post. */
  post: Post

  /** The liked reply, when liking a reply. */
  reply: Reply
}
