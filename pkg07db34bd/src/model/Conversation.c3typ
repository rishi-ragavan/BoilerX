/**
 * A private 1:1 DM thread between a professor (initiator) and a student (recipient), started from a thread (see
 * {@link DmApi#startConversation}). The student can only reply inside it; only the professor can end it.
 */
@db(index=['initiator', 'recipient', 'post'])
entity type Conversation {

  /** The post the conversation was started from, if any. */
  post: Post

  /** The FACULTY member who started the conversation. */
  initiator: !ForumMember

  /** The student: the post's author, or the author of the reply the professor clicked. */
  recipient: !ForumMember

  /** When the conversation was started. */
  createdAt: datetime

  /** When the professor ended the conversation; null while it is open. Ended conversations are read-only. */
  endedAt: datetime

  /** Messages in this conversation. */
  messages: [Message](conversation)
}
