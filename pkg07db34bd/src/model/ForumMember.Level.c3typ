/**
 * The academic level of a {@link ForumMember}, ordered UG → MS → PHD → FACULTY for level-proximity matching.
 */
enum type ForumMember.Level {
  /**
   * Undergraduate student.
   */
  UG,
  /**
   * Master's student.
   */
  MS,
  /**
   * PhD student.
   */
  PHD,
  /**
   * Faculty member.
   */
  FACULTY,
  /**
   * Alum.
   */
  ALUMNI
}
