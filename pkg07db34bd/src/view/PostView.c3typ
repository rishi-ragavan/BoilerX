/**
 * The UI-safe view of a {@link Post}. Returned only by {@link ForumApi}; never contains the author's identity
 * when the post is anonymous.
 */
type PostView {

  /** Post id. */
  id: string

  /** Always QUESTION. */
  postType: string

  /** Title. */
  title: string

  /** Body. */
  body: string

  /** PUBLIC or EXPERTS_ONLY. */
  visibility: string

  /** Space: STUDENT, EXPERTS, or ALUMNI. */
  space: string

  /** Routed department. */
  department: string


  /** Creation time. */
  createdAt: datetime

  /** How the author is shown. */
  author: AuthorView

  /**
   * Only the VIEWER's own match (empty unless the viewer was tagged). The full list of tagged experts is never
   * published: combined with anonymous 🎯 replies it would reveal who wrote them.
   */
  experts: [ExpertView]

  /** How many experts were tagged (safe to show to everyone). Always 0 for Student-space posts. */
  expertCount: int


  /** Number of replies (shown as "View N comments"). */
  replyCount: int


  /** Whether the acting member wrote the post. */
  isMine: boolean

  /** Whether the acting member is one of the matched experts. */
  viewerIsMatchedExpert: boolean
}
