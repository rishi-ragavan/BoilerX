/**
 * The viewer's own match on a {@link PostView} ("why you were tagged"). Never lists other tagged people.
 */
type ExpertView {

  /** The expert's {@link ForumMember} id (always the viewer). */
  memberId: string

  /** Display name (the viewer's own). */
  name: string

  /** "Expert" or "Alumni". */
  tag: string

  /** Expert's department. */
  department: string

  /** One-line reason (≤ 15 words). */
  reason: string

  /** Match score 0–100. */
  score: double
}
