/**
 * A {@link ForumMember} as the persona switcher and the member's own profile see it. Excludes the email.
 */
type MemberView {

  /** Member id (pass as `actorId`). */
  id: string

  /** Display name. */
  name: string

  /** STUDENT, FACULTY (professor), or ALUMNI. */
  role: string

  /** Department. */
  department: string

  /** Employer (alumni). */
  employer: string

  /** Bio. */
  bio: string

  /** Flair tags: research interests (professors) or career role (alumni); always empty for students. */
  tags: [string]

  /** Default for the composer/reply anonymity toggle (always true for students). */
  anonByDefault: boolean

  /** "Expert", "Alumni", or null (students). */
  tag: string

  /** The member's flair as it appears when they post under their name (null for students). */
  flair: string

  /** Summary for the persona switcher: "Expert · Finance", "Alumni · Google", "Student". */
  roleLabel: string
}
