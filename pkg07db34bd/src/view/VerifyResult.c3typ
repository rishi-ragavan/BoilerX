/**
 * Result of {@link Verify#check}.
 */
type VerifyResult {

  /** Whether the email is admitted for the role. */
  verified: boolean

  /** Effective role (`@alumni.purdue.edu` → ALUMNI). */
  role: string

  /** e.g. "Purdue student", "Purdue alum", or why the email is not admitted. */
  label: string
}
