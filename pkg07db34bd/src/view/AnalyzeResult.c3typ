/**
 * Output of {@link AiPipeline#analyzePost}: safety verdict, routing, tags, and ranked experts.
 */
type AnalyzeResult {

  /** False when the post must be blocked. */
  safe: boolean

  /** Why the post was blocked (CAPS pointer for self-harm). */
  safetyReason: string

  /** STUDENT, EXPERTS, or ALUMNI (FACULTY is accepted as an alias of EXPERTS). */
  space: string

  /** Best-fit department, for any space (null when none fits, e.g. campus life). */
  department: string

  /** Topic tags the pipeline may return. Not stored or shown (posts carry no topic tags). */
  tags: [string]

  /** Up to 5 professors/alumni from the directory, best first; never the author, never students. */
  experts: [ExpertSuggestion]
}
