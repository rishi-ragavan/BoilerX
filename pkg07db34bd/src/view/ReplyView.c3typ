/**
 * The UI-safe view of a {@link Reply}.
 */
type ReplyView {

  /** Reply id. */
  id: string

  /** Reply text. */
  body: string

  /** Creation time. */
  createdAt: datetime

  /** How the replier is shown, including the 🎯 flair. */
  author: AuthorView

  /**
   * EXPERTS, ALUMNI, or STUDENT. Replies arrive grouped by this value, with the post's own space's group FIRST
   * (Experts space → EXPERTS first, Alumni → ALUMNI first, Student → STUDENT first). Render a header per group.
   */
  authorGroup: string



  /** Whether the acting member wrote the reply. */
  isMine: boolean
}
