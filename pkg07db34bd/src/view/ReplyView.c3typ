/**
 * The UI-safe view of a {@link Reply}.
 */
type ReplyView {

  /** Reply id. */
  id: string

  /** Reply text. */
  body: string

  /** Creation time. */
  createdAt: datetime

  /** How the replier is shown, including the 🎯 flair. */
  author: AuthorView

  /** Number of likes on the reply. */
  likeCount: int

  /** Whether the acting member liked the reply. */
  likedByMe: boolean

  /** Whether the acting member wrote the reply. */
  isMine: boolean
}
