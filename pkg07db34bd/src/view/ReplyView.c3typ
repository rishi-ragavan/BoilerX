/**
 * The UI-safe view of a {@link Reply}.
 */
type ReplyView {

  /** Reply id. */
  id: string

  /** Reply text. */
  body: string

  /** Creation time. */
  createdAt: datetime

  /** How the replier is shown, including the 🎯 flair. */
  author: AuthorView

  /** FACULTY, ALUMNI, or STUDENT — replies arrive grouped in that order; render a header per group. */
  authorGroup: string



  /** Whether the acting member wrote the reply. */
  isMine: boolean
}
