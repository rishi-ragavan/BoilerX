/**
 * A DM thread summary, returned by {@link DmApi}.
 */
type ConversationView {

  /** Conversation id. */
  id: string

  /** The other participant (a student is shown only by their anonymous handle). */
  otherParty: AuthorView

  /** Title of the post the DM was started from. */
  postTitle: string

  /** Preview of the latest message. */
  lastMessage: string

  /** Time of the latest message (or the start). */
  createdAt: datetime

  /** True once the professor ended it; no more messages can be sent. */
  ended: boolean

  /** When it was ended (null while open). */
  endedAt: datetime

  /** True when the viewer is the professor who started it and it is still open. */
  canEnd: boolean
}
