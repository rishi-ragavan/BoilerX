/**
 * Composer input for {@link ForumApi#createPost}.
 */
type NewPostInput {

  /** Title. */
  title: !string

  /** Body. */
  body: string

  /** Optional; only QUESTION is accepted. */
  postType: string

  /** PUBLIC (default) or EXPERTS_ONLY. */
  visibility: string

  /** Anonymity choice (ignored for students, who are always anonymous). */
  isAnonymous: boolean
}
