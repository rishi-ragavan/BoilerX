/**
 * One row of the expert directory {@link ForumApi#createPost} passes to {@link AiPipeline#analyzePost}. Only
 * professors (role FACULTY) and alumni are ever in it: students are never tagged.
 */
type DirectoryEntry {

  /** {@link ForumMember} id. */
  memberId: string

  /** FACULTY (professor) or ALUMNI. */
  role: string

  /** Department. */
  department: string

  /** Employer (alumni). */
  employer: string

  /** Research interests (professors) or broad career role (alumni). */
  tags: [string]

  /** First 120 characters of the bio. */
  bio: string
}
