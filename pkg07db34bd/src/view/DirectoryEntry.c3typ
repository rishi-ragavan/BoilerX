/**
 * One row of the compact expert directory {@link ForumApi#createPost} passes to {@link AiPipeline#analyzePost}.
 */
type DirectoryEntry {

  /** {@link ForumMember} id. */
  memberId: string

  /** STUDENT, FACULTY, or ALUMNI. */
  role: string

  /** UG, MS, PHD, FACULTY, or ALUMNI. */
  level: string

  /** Department. */
  department: string

  /** Expertise tags. */
  tags: [string]

  /** Badges. */
  badges: [string]

  /** First 120 characters of the bio. */
  bio: string

  /** Reputation. */
  reputation: int
}
