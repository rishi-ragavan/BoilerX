/**
 * How a person appears on a post, reply, or DM. Anonymous items carry NO id, name, or email.
 */
type AuthorView {

  /** Real name when posting under their name; otherwise "Boiler a3f1" (student), "Purdue professor", "Purdue alum". */
  displayName: string

  /** "Expert" for professors, "Alumni" for alumni, null for students. */
  tag: string

  /**
   * Professors: "{department} · {research interests}" (e.g. "Finance · stock market, asset pricing").
   * Alumni: their broad career role (e.g. "SWE"), plus " · {employer}" only when named. Students: null.
   */
  flair: string

  /** True when the identity is hidden. */
  isAnonymous: boolean

  /** Member id for linking to the profile — null when anonymous. */
  memberId: string
}
